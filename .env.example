# Server-side only. Never set VITE_ on these values.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Read-only Notion connection and data source IDs (not database page IDs).
NOTION_TRAVEL_TOKEN=
NOTION_TRAVEL_TRIPS_SOURCE_ID=
NOTION_TRAVEL_SCHEDULE_SOURCE_ID=
NOTION_TRAVEL_BOOKINGS_SOURCE_ID=
NOTION_TRAVEL_BUDGETS_SOURCE_ID=
NOTION_TRAVEL_EXPENSES_SOURCE_ID=
NOTION_TRAVEL_RECEIPTS_SOURCE_ID=
NOTION_TRAVEL_CHECKLIST_SOURCE_ID=
# Optional until the separate shopping data source is connected.
NOTION_TRAVEL_SHOPPING_SOURCE_ID=
# Optional: existing 여행지 정보 data source (server only).
NOTION_TRAVEL_INFO_SOURCE_ID=

# Trip details require a configured PIN and shared Upstash Redis quota.
TRAVEL_DETAIL_PINS=
TRAVEL_REDIS_REST_URL=
TRAVEL_REDIS_REST_TOKEN=
